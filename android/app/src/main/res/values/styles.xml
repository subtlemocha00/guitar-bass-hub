<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Phase 7: launch background is the dark theme colour so Android cold start
         does not flash white on this dark app; it hands off to the (also-dark)
         WebView, then the dark React app — one continuous dark surface, no seam.
         android:background is the framework attribute honoured across API levels.
         Phase 9 (native polish): the default Capacitor splash images
         (drawable*/splash.png — a Capacitor logo on white) were removed, since this
         solid-colour launch theme is what actually renders and they carried default
         branding. To show a centred brand logo at launch instead of a plain dark
         screen, add a windowSplashScreenAnimatedIcon here (Android 12+ splash API)
         with a logo drawable — see docs/platform-roadmap.md. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/splashBackground</item>
    </style>
</resources>