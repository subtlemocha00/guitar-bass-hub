# Firebase web app configuration.
#
# Copy this file to `.env` and fill in the values from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration
#
# These are client-side identifiers, not secrets — they ship in the built
# bundle by design. Access is controlled by Firestore security rules, not by
# hiding these values. `.env` is gitignored so each environment stays separate.
#
# Vite only exposes variables prefixed with VITE_ to the app, and inlines them
# at build time — the build must be re-run after any change here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
