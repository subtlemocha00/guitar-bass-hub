{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Opening external URLs in the system browser. Nothing else: the frontend touches no other Tauri API.",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
